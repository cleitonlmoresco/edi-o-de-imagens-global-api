PORT=3000

# Token compartilhado com o app. OBRIGATÓRIO — sem ele o servidor não inicia.
# Gere com: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
APP_TOKEN=

# Limite de requisições por IP por hora
RATE_LIMIT_PER_HOUR=30

# Ordem de tentativa dos provedores (fallback automático em 402/429/erro)
PROVIDER_ORDER=photoroom,removebg,clipdrop

# Photoroom: use true para o sandbox (1.000 chamadas/mês, com marca d'água)
PHOTOROOM_API_KEY=
PHOTOROOM_SANDBOX=true

# remove.bg: 50 chamadas/mês grátis
REMOVEBG_API_KEY=

# Clipdrop: 100 créditos grátis (uso de desenvolvimento)
CLIPDROP_API_KEY=

# Limites de imagem e cache
MAX_IMAGE_MB=10
CACHE_LIMIT=200
CACHE_MAX_MB=64
PROVIDER_TIMEOUT_MS=45000

# Só habilite atrás de um proxy reverso (evita burlar o rate limit via X-Forwarded-For)
# TRUST_PROXY=1
